# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Instagram Graph API (Business or Creator account linked to a Facebook Page).
# Only required when actually publishing — `--mode build` runs without these.
# 1. Create a Meta app, add the Instagram Graph API product.
# 2. Exchange a short-lived user token for a long-lived page token.
# 3. Find your Instagram Business Account ID via:
#    GET https://graph.facebook.com/v20.0/{page-id}?fields=instagram_business_account
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAB...

# Public HTTPS host that serves the rendered slide PNGs for Instagram to fetch.
# The Graph API does NOT accept base64 — the images must live at public URLs.
# The agent writes assets/daily_1.png ... assets/daily_5.png and the publisher
# expects {PUBLIC_IMAGE_BASE_URL}/daily_1.png etc to be reachable.
# The bundled GitHub Actions workflow pushes the slides to a `gh-pages` branch.
# Only required when actually publishing — `--mode build` runs without it.
PUBLIC_IMAGE_BASE_URL=https://<user>.github.io/<repo>

# Brand identity for the carousel + caption voice.
BRAND_HANDLE=@dailyaitools
BRAND_NAME=Daily AI Tools

# === Monetization slots (all optional) ===

# Affiliate links keyed by tool slug. The agent only attaches an affiliate URL
# when the day's chosen tool slug actually matches one of these — never fakes
# a misaligned promotion.
# Format: comma-separated `slug=url` pairs. Slugs are case-insensitive and
# match either the tool's lowercase name or the model-supplied slug.
# Example: cursor=https://cursor.com/?ref=YOURCODE,perplexity=https://perplexity.ai/pro?referral=YOURCODE
AFFILIATE_LINKS=

# Newsletter signup URL (Beehiiv, ConvertKit, Substack, etc). When set, every
# caption ends with a "daily AI tools in your inbox" CTA pointing at link-in-bio.
# Put the actual URL on your link-in-bio landing page — IG strips URLs from captions.
NEWSLETTER_URL=https://yourbrand.beehiiv.com

# Gumroad (or other digital product) URL — your "AI prompt pack" or course.
# When set, captions surface a "prompt pack pinned in our bio" line.
GUMROAD_URL=https://yourstore.gumroad.com/l/ai-prompt-pack

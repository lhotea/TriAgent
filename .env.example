# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Instagram Graph API (Business or Creator account linked to a Facebook Page)
# 1. Create a Meta app, add the Instagram Graph API product.
# 2. Exchange a short-lived user token for a long-lived page token.
# 3. Find your Instagram Business Account ID via:
#    GET https://graph.facebook.com/v20.0/{page-id}?fields=instagram_business_account
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAB...

# Public HTTPS host that serves the rendered PNG for Instagram to fetch.
# The Graph API does NOT accept base64 — the image must live at a public URL.
# Point this at any static host you control (S3/Cloudflare R2/GitHub Pages/etc.)
# The agent uploads assets/daily.png there; see publisher.py for the contract.
PUBLIC_IMAGE_BASE_URL=https://cdn.example.com/triagent

# Link-in-bio target — the single monetized landing page all captions CTA toward.
# Use Linktree, Beacons, or a self-hosted page loaded with affiliate links.
LINK_IN_BIO_URL=https://linktr.ee/yourtrihandle

# Optional: comma-separated affiliate URLs rotated into the caption.
# Example: Amazon associates, Wiggle, Rogue Running, TrainingPeaks referral.
AFFILIATE_URLS=https://amzn.to/xxxxx,https://wiggle.com/?aff=xxxxx

# Brand identity for the image card + caption voice
BRAND_HANDLE=@yourtrihandle
BRAND_NAME=TriPulse Daily
